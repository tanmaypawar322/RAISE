PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
MARKETING_URL=http://localhost:3001
PUBLIC_BASE_URL=http://localhost:3000

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/raise_db

# JWT Secret (Must be set to a strong secret in production)
JWT_SECRET=raise_super_secret_jwt_key_2026_dev_mode

# Phone & OTP Cryptography (Required in production)
# 32-byte key (64 hex characters) for AES-256-GCM phone/email encryption
PHONE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Server secrets for deterministic HMAC-SHA256 indexes
PHONE_HASH_SECRET=raise_phone_hash_secret_example_value_change_in_production
EMAIL_HASH_SECRET=raise_email_hash_secret_example_value_change_in_production
OTP_HASH_SECRET=raise_otp_hash_secret_example_value_change_in_production

# Global daily SMS rate limit cap (cost protection against SMS pumping)
OTP_DAILY_CAP=500

# Non-production only: fixed verification code for automated testing.
# WARNING: Server startup will immediately fail if this is set in production.
OTP_DEV_FIXED_CODE=123456

# Pluggable SMS Provider: 'console' | 'msg91' | 'whatsapp'
OTP_PROVIDER=console

# MSG91 Indian SMS Gateway (when OTP_PROVIDER=msg91)
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=
# MSG91_DLT_TE_ID=

# Pluggable Email Provider: 'console' | 'smtp' | 'resend' | 'ses'
EMAIL_PROVIDER=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=no-reply@raise.org

PASSWORD_RESET_TTL_MINUTES=30

# Auth Controls & Pilot Safeguards
AUTH_ALLOW_EMAIL_PASSWORD=true
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_REQUIRE_PHONE_TO_RAISE=false
NEW_ACCOUNT_DAILY_ACTION_LIMIT=20

# Non-production only test flags (startup fails if enabled in production)
DEV_MAILBOX=true
DEV_SKIP_OFFICIAL_SECOND_FACTOR=false

# Bot Protection: Cloudflare Turnstile secret key (optional in dev, recommended in prod)
# TURNSTILE_SECRET=

# Pluggable Storage Provider: 'local' or 's3'
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads

# AWS S3 / Cloudflare R2 Config (for production)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
